# opencode2api 环境变量示例
# 复制为 .env 后填写

# 网关鉴权 key（客户端请求 OpenAI API 时携带 Bearer 值）——必填
OC2A_AUTH=change-me

# OpenCode 官方 key（oc_sk_ 开头，https://opencode.ai/auth 获取）——必填
OPENCODE_API_KEY=oc_sk_xxxx

# 可选：OpenCode Console OAuth access token（device flow 登录后生成）
# 设置后 opencode CLI 用它作为模型 API key，free tier 资格更全
OPENCODE_CONSOLE_TOKEN=